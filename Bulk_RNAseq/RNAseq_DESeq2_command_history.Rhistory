list.files()
file.list <- list.files( path = "./", pattern = "*ReadsPerGene.out.tab$") #lists (list.files) in your current directory (path = ./), looking for the ReadsPerGene.out.tab files (STAR generated counts files) and sets those file names to a variable called file.list
counts.files <- lapply(file.list, read.table, skip = 4) #loads the files from the file list into the R environment, skipping the first 4 lines
counts <- as.data.frame( sapply( counts.files, function(x) x[ ,2] ) ) #selects from all the files only the second column (unstranded column in this experiment for the counts) and make a data frame with all of the counts
colnames(counts) <- file.list #sets the column names as the file names so you can distinguish between libraries
row.names(counts) <- counts.files[[1]]$V1 #sets the row names as the gene names from the counts files (all counts file if from same species and assembly will have same gene names in first column)
dim(counts)
